<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\SalesRule\Model\Rule\Condition\Product\Combine">
        <plugin name="falconmedia_bundle_deals_item_condition" type="FalconMedia\BundleDeals\Plugin\SalesRule\AddItemCondition"/>
    </type>
    <virtualType name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="falconmedia_bundle_deals" xsi:type="array">
                    <item name="class" xsi:type="string">FalconMedia\BundleDeals\Ui\DataProvider\Product\Form\Modifier\BundleDeals</item>
                    <item name="sortOrder" xsi:type="number">200</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
</config>
