<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="salesrule_validator_process">
        <observer name="falconmedia_bundle_deals_limit_units" instance="FalconMedia\BundleDeals\Observer\LimitDiscountToSetUnits"/>
    </event>
    <event name="falconmedia_bundle_deal_rule_save_after">
        <observer name="falconmedia_bundle_deals_sync" instance="FalconMedia\BundleDeals\Observer\SyncRuleAfterSave"/>
    </event>
    <event name="falconmedia_bundle_deal_slot_save_after">
        <observer name="falconmedia_bundle_deals_sync" instance="FalconMedia\BundleDeals\Observer\SyncRuleAfterSave"/>
    </event>
    <event name="falconmedia_bundle_deal_slot_delete_after">
        <observer name="falconmedia_bundle_deals_sync" instance="FalconMedia\BundleDeals\Observer\SyncRuleAfterSave"/>
    </event>
    <event name="falconmedia_bundle_deal_rule_delete_before">
        <observer name="falconmedia_bundle_deals_delete_generated" instance="FalconMedia\BundleDeals\Observer\DeleteGeneratedRules"/>
    </event>
    <event name="falconmedia_bundle_deal_rule_delete_after">
        <observer name="falconmedia_bundle_deals_disable_orphans" instance="FalconMedia\BundleDeals\Observer\DisableOrphanedRules"/>
    </event>
    <event name="falconmedia_bundle_deal_slot_delete_before">
        <observer name="falconmedia_bundle_deals_delete_generated" instance="FalconMedia\BundleDeals\Observer\DeleteGeneratedRules"/>
    </event>
    <event name="hyva_config_generate_before">
        <observer name="falconmedia_bundle_deals_hyva_config" instance="FalconMedia\BundleDeals\Observer\RegisterModuleForHyvaConfig"/>
    </event>
</config>
