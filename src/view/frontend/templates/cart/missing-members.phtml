/**
 * Cart page block with the bundle deal products that complete a set the cart has started. Each product is added on
 * its own; the page reloads afterwards so the totals show the set discount.
 */
declare(strict_types=1);

use FalconMedia\BundleDeals\Block\Cart\MissingMembers;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;

/**
 * @var MissingMembers $block
 */
/**
 * @var Escaper $escaper
 */
/**
 * @var HyvaCsp $hyvaCsp
 */

$texts = $block->getData('texts');

$bundles = $block->getBundles();
if (!$bundles) {
    return;
}

$uid = 'fmBundleMissing_' . substr(hash('sha256', (string) $block->getNameInLayout()), 0, 12);
$config = [
    'bundles' => $bundles,
    'addUrl' => $block->getAddUrl(),
    'i18n' => [
        'choose' => (string) __('Choose %1 for %2'),
        'error' => (string) __('We can\'t add this product to your shopping cart right now.'),
        'from' => (string) __('From %1'),
        'percentOff' => (string) __('-%1% in bundle'),
        'fixedOff' => (string) __('-%1 in bundle'),
    ],
];
$jsonFlags = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE;
?>
<script>
    function <?= /* @noEscape */ $uid ?>() {
        const config = <?= /* @noEscape */ json_encode($config, $jsonFlags) ?>;
        const selections = {};
        config.bundles.forEach((bundle) => {
            bundle.slots.forEach((slot) => {
                slot.candidates.forEach((product) => {
                    const choice = {};
                    (product.options ? product.options.attributes : []).forEach((attribute) => {
                        choice[attribute.id] = attribute.options.length === 1 ? attribute.options[0].id : '';
                    });
                    selections[slot.slotId + '_' + product.productId] = choice;
                });
            });
        });

        return {
            bundles: config.bundles.map((bundle) => Object.assign({}, bundle, {
                slots: bundle.slots.map((slot) => Object.assign({}, slot, {selected: 0, open: false}))
            })),
            selections: selections,
            errors: {},
            loading: null,

            key(slot, product) {
                return slot.slotId + '_' + product.productId;
            },

            product(slot) {
                return slot.candidates[slot.selected];
            },

            pick(slot, index) {
                slot.selected = index;
                slot.open = false;
                delete this.errors[slot.slotId];
            },

            isSelected(slot, product, attributeId, optionId) {
                return this.selections[this.key(slot, product)][attributeId] === optionId;
            },

            choose(slot, product, attributeId, optionId) {
                this.selections[this.key(slot, product)][attributeId] = optionId;
                delete this.errors[slot.slotId];
            },

            isAvailable(slot, product, attributeId, option) {
                const choice = this.selections[this.key(slot, product)];
                return option.products.some((childId) => {
                    const values = product.options.index[childId] || {};
                    return Object.keys(choice).every(
                        (id) => id === attributeId || !choice[id] || values[id] === choice[id]
                    );
                });
            },

            childId(slot, product) {
                if (!product.options) {
                    return null;
                }
                const choice = this.selections[this.key(slot, product)];
                if (Object.values(choice).some((value) => !value)) {
                    return null;
                }
                return Object.keys(product.options.index).find((childId) => {
                    const values = product.options.index[childId];
                    return Object.keys(choice).every((id) => values[id] === choice[id]);
                }) || null;
            },

            prices(slot, product) {
                const childId = this.childId(slot, product);
                const price = childId && product.options.prices[childId]
                    ? product.options.prices[childId]
                    : {finalPrice: product.finalPrice, regularPrice: product.regularPrice};
                return {
                    finalPrice: price.finalPrice,
                    regularPrice: Math.max(price.regularPrice || 0, price.finalPrice)
                };
            },

            isPriceRange(slot, product) {
                if (!product.options || this.childId(slot, product)) {
                    return false;
                }
                const values = Object.values(product.options.prices).map((price) => price.finalPrice);
                return values.length > 1 && Math.min(...values) !== Math.max(...values);
            },

            bundlePrice(slot, product) {
                const prices = this.prices(slot, product);
                const finalPrice = prices.finalPrice;
                if (slot.discount.excludeSpecialPrice && finalPrice < prices.regularPrice) {
                    return finalPrice;
                }
                const amount = Number(slot.discount.amount) || 0;
                if (slot.discount.type === 'percent') {
                    return Math.max(0, finalPrice - finalPrice * amount / 100);
                }
                if (slot.discount.type === 'fixed') {
                    return Math.max(0, finalPrice - amount);
                }
                return finalPrice;
            },

            hasDiscount(slot) {
                return slot.discount.type !== 'none' && Number(slot.discount.amount) > 0;
            },

            discountLabel(slot) {
                if (slot.discount.type === 'percent') {
                    return config.i18n.percentOff.replace('%1', Number(slot.discount.amount).toLocaleString());
                }
                return config.i18n.fixedOff.replace('%1', hyva.formatPrice(Number(slot.discount.amount)));
            },

            format(value) {
                return hyva.formatPrice(value);
            },

            formatFrom(slot, product) {
                const price = this.format(this.bundlePrice(slot, product));
                return this.isPriceRange(slot, product) ? config.i18n.from.replace('%1', price) : price;
            },

            missing(slot) {
                const product = this.product(slot);
                if (!product.options) {
                    return [];
                }
                const choice = this.selections[this.key(slot, product)];
                return product.options.attributes
                    .filter((attribute) => !choice[attribute.id])
                    .map((attribute) => config.i18n.choose
                        .replace('%1', attribute.label.toLowerCase())
                        .replace('%2', product.name));
            },

            async add(bundle, slot) {
                if (this.missing(slot).length || this.loading) {
                    return;
                }
                this.loading = slot.slotId;
                delete this.errors[slot.slotId];

                const product = this.product(slot);
                const body = new FormData();
                body.append('form_key', hyva.getFormKey());
                body.append('rule_id', bundle.ruleId);
                body.append('complete', '0');
                body.append('items[0][slot_id]', slot.slotId);
                body.append('items[0][product_id]', product.productId);
                const choice = this.selections[this.key(slot, product)];
                Object.keys(choice).forEach((attributeId) => {
                    body.append('items[0][super_attribute][' + attributeId + ']', choice[attributeId]);
                });

                try {
                    const response = await fetch(config.addUrl, {
                        method: 'POST',
                        body: body,
                        headers: {'X-Requested-With': 'XMLHttpRequest'}
                    });
                    const result = await response.json();
                    if (result.success) {
                        window.location.reload();
                        return;
                    }
                    const slotError = (result.errors || []).find((error) => error.slotId);
                    this.errors[slot.slotId] = slotError ? slotError.message : (result.message || config.i18n.error);
                } catch (e) {
                    this.errors[slot.slotId] = config.i18n.error;
                }
                this.loading = null;
            }
        };
    }
</script>
<?php $hyvaCsp->registerInlineScript() ?>

<section class="fm-bundle-missing my-fmbd-6 text-base text-fmbd-text"
         aria-labelledby="<?= $escaper->escapeHtmlAttr($uid) ?>_title"
