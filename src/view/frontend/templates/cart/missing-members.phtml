                                            <button type="button"
                                                    class="w-full flex items-center gap-fmbd-3 rounded-fmbd-md border
                                                        bg-fmbd-bg p-fmbd-2 text-left hover:border-fmbd-border-strong
                                                        focus:outline-none focus-visible:ring-2
                                                        focus-visible:ring-fmbd-focus"
