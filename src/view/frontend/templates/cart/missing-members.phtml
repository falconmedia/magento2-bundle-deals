                                                               product(slot).productId + '_' + attribute.id"
                                                           :value="option.id"
                                                           :checked="isSelected(slot, product(slot), attribute.id,
                                                               option.id)"
                                                           :disabled="!isAvailable(slot, product(slot), attribute.id,
                                                               option)"
                                                           @change="choose(slot, product(slot), attribute.id,
                                                               option.id)"
                                                    >
                                                    <span class="fmbd-option__btn" x-text="option.label"></span>
                                                </label>
                                            </template>
                                        </div>
                                    </fieldset>
                                </template>
                            </div>
