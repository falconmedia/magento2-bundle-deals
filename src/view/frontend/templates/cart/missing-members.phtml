                                   x-text="product(slot).name"></a>
                                <p class="m-0 flex flex-wrap items-baseline gap-fmbd-2 fmbd-num">
                                    <span class="font-semibold"
                                          :class="bundlePrice(slot, product(slot)) < prices(slot,
                                              product(slot)).regularPrice ? 'text-fmbd-primary' : ''"
                                          x-text="formatFrom(slot, product(slot))"></span>
                                    <template x-if="bundlePrice(slot, product(slot)) < prices(slot,
                                        product(slot)).regularPrice">
                                        <span class="text-sm text-fmbd-text-muted line-through">
                                            <span class="sr-only"><?= $escaper->escapeHtml(
                                                __('Regular price')
                                            ) ?></span>
                                            <span x-text="format(prices(slot, product(slot)).regularPrice)"></span>
                                        </span>
                                    </template>
                                </p>
                            </div>
                        </div>

                        <template x-if="slot.candidates.length > 1">
                            <div>
                                <button type="button"
                                        class="inline-flex items-center gap-fmbd-1 min-h-a11y text-sm font-medium
                                            underline underline-offset-4 rounded-fmbd-sm focus:outline-none
                                            focus-visible:ring-2 focus-visible:ring-fmbd-focus"
                                        :aria-expanded="slot.open ? 'true' : 'false'"
                                        @click="slot.open = !slot.open"
                                >
                                    <?= $escaper->escapeHtml(__('Choose another')) ?>
                                </button>
                                <ul x-show="slot.open" x-cloak
                                    class="m-0 mt-fmbd-2 p-0 list-none flex flex-col gap-fmbd-2 max-h-64 overflow-y-auto"
                                    :aria-label="slot.title"
                                >
                                    <template x-for="(candidate, candidateIndex) in slot.candidates"
                                        :key="candidate.productId">
