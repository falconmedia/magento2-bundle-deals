                                    </template>
                                </ul>
                            </div>
                        </template>

                        <template x-if="product(slot).options">
                            <div class="flex flex-col gap-fmbd-3">
                                <template x-for="attribute in product(slot).options.attributes" :key="attribute.id">
                                    <fieldset class="fmbd-options">
