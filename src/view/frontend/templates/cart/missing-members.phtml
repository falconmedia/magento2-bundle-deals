                                        <div class="grid grid-cols-4 sm:grid-cols-5 gap-fmbd-2">
                                            <template x-for="option in attribute.options" :key="option.id">
                                                <label class="fmbd-option">
                                                    <input type="radio"
                                                           class="fmbd-option__input peer sr-only"
