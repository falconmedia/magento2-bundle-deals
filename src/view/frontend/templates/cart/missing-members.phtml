                        <p x-show="errors[slot.slotId]" x-cloak role="alert"
                           class="m-0 rounded-fmbd-md bg-fmbd-error-bg px-fmbd-3 py-fmbd-2 text-sm text-fmbd-error"
                           x-text="errors[slot.slotId]"></p>

                        <button type="button"
                                class="fmbd-btn fmbd-btn--inverse w-full mt-auto disabled:opacity-50
