                                :disabled="missing(slot).length > 0 || loading !== null"
                                :title="missing(slot).join(', ') || null"
                                :aria-busy="loading === slot.slotId ? 'true' : 'false'"
                                @click="add(bundle, slot)"
                        >
                            <span x-show="loading !== slot.slotId"><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                            <span x-show="loading ===
