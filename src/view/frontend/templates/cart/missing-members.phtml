                            <div class="min-w-0 flex-1 flex flex-col gap-fmbd-1">
                                <p class="m-0 flex flex-wrap items-center gap-fmbd-2 text-fmbd-xs text-fmbd-text-muted">
                                    <span x-text="slot.title"></span>
                                    <template x-if="hasDiscount(slot)">
                                        <span class="rounded-full bg-fmbd-discount-bg px-2 py-0.5 font-semibold
                                            text-fmbd-discount"
