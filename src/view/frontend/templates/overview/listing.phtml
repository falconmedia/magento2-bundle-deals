                </div>
            <?php elseif ($overview->getIntro() !== ''): ?>
                <p class="mt-fmbd-3 mb-0 text-fmbd-text-soft leading-normal">
                    <?= $escaper->escapeHtml($overview->getIntro()) ?>
                </p>
            <?php endif; ?>
        </div>
        <ul class="flex flex-col gap-fmbd-2 text-fmbd-sm">
            <?php if ($maxDiscount > 0): ?>
                <li class="flex items-center gap-fmbd-2">
                    <svg class="text-fmbd-ok shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
                    <?= $escaper->escapeHtml($texts->get('overview_up_to', [$maxDiscount])) ?>
                </li>
            <?php endif; ?>
            <li class="flex items-center gap-fmbd-2">
                <svg class="text-fmbd-ok shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
                <?= $escaper->escapeHtml(__('Choose the size per item')) ?>
            </li>
            <li class="flex items-center gap-fmbd-2">
                <svg class="text-fmbd-ok shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
                <?= $escaper->escapeHtml(__('Discount applied directly in your cart')) ?>
            </li>
        </ul>
    </div>

    <div class="flex flex-wrap items-end justify-between gap-fmbd-4 border-y border-fmbd-border py-fmbd-4">
        <?php if ($sportFacets): ?>
            <nav aria-label="<?= $escaper->escapeHtmlAttr(__('Sport')) ?>"
                 class="w-full md:w-auto -mx-fmbd-4 px-fmbd-4 md:mx-0 md:px-0 overflow-x-auto">
                <ul class="flex flex-nowrap md:flex-wrap gap-fmbd-2">
                    <li>
                        <a href="<?= $escaper->escapeUrl($allSportsUrl) ?>"
                           class="<?= /* @noEscape */ $sportChipClass ?><?= empty($filters['sport'])
                               ? ' fmbd-chip--active' : '' ?>"
                           <?= empty($filters['sport']) ? 'aria-current="true"' : '' ?>>
                            <?= $escaper->escapeHtml(__('All sports')) ?>
                        </a>
                    </li>
                    <?php foreach ($sportFacets as $option): ?>
                        <li>
                            <a href="<?= $escaper->escapeUrl($option['url']) ?>" rel="nofollow"
