                     stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
        </div>
        <?php if ($sportFacets): ?>
            <p class="text-fmbd-sm font-semibold mb-fmbd-2"><?= $escaper->escapeHtml(__('Sport')) ?></p>
            <ul class="flex flex-wrap gap-fmbd-2 mb-fmbd-5">
                <li>
                    <a href="<?= $escaper->escapeUrl($allSportsUrl) ?>"
