/**
 * Bundle deal overview page: heading, filters, cards with colour switch, pager and empty state.
 */
declare(strict_types=1);

use FalconMedia\BundleDeals\Block\Overview\Listing;
use FalconMedia\BundleDeals\ViewModel\Overview;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Cms\Block\Block as CmsBlock;
use Magento\Framework\Escaper;

/**
 * @var Listing $block
 */
/**
 * @var Escaper $escaper
 */
/**
 * @var HyvaCsp $hyvaCsp
 */

$texts = $block->getData('texts');

$overview = $block->getOverview();
$cards = $overview->getCards();
$pager = $overview->getPager();
$facets = $overview->getFacets();
$filters = $overview->getFilters();
$sportFacets = $facets['sport'] ?? [];
$brandFacets = $facets['brand'] ?? [];
$sortOptions = $overview->getSortOptions();
$maxDiscount = $cards ? (int) round(max(array_column($cards, 'maxDiscountPercent'))) : 0;
$activeLabels = [];
foreach ($facets as $options) {
    foreach ($options as $option) {
        if ($option['active']) {
            $activeLabels[] = $option['label'];
        }
    }
}
$allSportsUrl = $overview->getUrl([Overview::PARAM_SPORT => null, Overview::PARAM_PAGE => null]);
$allBrandsUrl = $overview->getUrl([$overview->getBrandParam() => null, Overview::PARAM_PAGE => null]);
$sportChipClass = 'fmbd-chip shrink-0 gap-fmbd-2 min-h-a11y focus-visible:outline focus-visible:outline-2 '
    . 'focus-visible:outline-offset-2 focus-visible:outline-fmbd-focus';

/**
 * Renders the brand and sort selects; used in the filter bar and in the mobile sheet.
 */
$renderSelects = function (string $idPrefix) use (
    $escaper,
    $overview,
    $filters,
    $brandFacets,
    $sortOptions,
    $allBrandsUrl
): void {
    ?>
    <form method="get" action="<?= $escaper->escapeUrl($overview->getResetUrl()) ?>"
          class="flex flex-wrap items-end gap-fmbd-4">
        <?php if (!empty($filters['sport'])): ?>
            <input type="hidden" name="<?= $escaper->escapeHtmlAttr(Overview::PARAM_SPORT) ?>"
                   value="<?= $escaper->escapeHtmlAttr($filters['sport']) ?>">
        <?php endif; ?>
        <?php if ($brandFacets): ?>
            <div class="flex flex-col gap-fmbd-1">
                <label for="<?= $escaper->escapeHtmlAttr($idPrefix) ?>-brand"
                       class="text-fmbd-sm font-semibold"><?= $escaper->escapeHtml(__('Brand')) ?></label>
                <select id="<?= $escaper->escapeHtmlAttr($idPrefix) ?>-brand"
                        name="<?= $escaper->escapeHtmlAttr($overview->getBrandParam()) ?>"
                        class="fmbd-select form-select pl-fmbd-4 min-w-48" @change="go">
                    <option value="" data-url="<?= $escaper->escapeUrl($allBrandsUrl) ?>">
                        <?= $escaper->escapeHtml(__('All brands')) ?>
                    </option>
                    <?php foreach ($brandFacets as $slug => $option): ?>
                        <option value="<?= $escaper->escapeHtmlAttr((string) $slug) ?>"
                                data-url="<?= $escaper->escapeUrl($option['active']
                                    ? $overview->getUrl([Overview::PARAM_PAGE => null])
                                    : $option['url']) ?>"
                                <?= $option['active'] ? 'selected' : '' ?>>
                            <?= $escaper->escapeHtml($option['label']) ?> (<?= (int) $option['count'] ?>)
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        <?php endif; ?>
        <div class="flex flex-col gap-fmbd-1">
            <label for="<?= $escaper->escapeHtmlAttr($idPrefix) ?>-sort"
                   class="text-fmbd-sm font-semibold"><?= $escaper->escapeHtml(__('Sort by')) ?></label>
            <select id="<?= $escaper->escapeHtmlAttr($idPrefix) ?>-sort"
                    name="<?= $escaper->escapeHtmlAttr(Overview::PARAM_SORT) ?>"
                    class="fmbd-select form-select pl-fmbd-4 min-w-48" @change="go">
                <?php foreach ($sortOptions as $option): ?>
                    <option value="<?= $escaper->escapeHtmlAttr($option['code']) ?>"
                            data-url="<?= $escaper->escapeUrl($option['url']) ?>"
                            <?= $option['active'] ? 'selected' : '' ?>>
                        <?= $escaper->escapeHtml($option['label']) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
        <button type="submit" class="fmbd-btn fmbd-btn--outline min-h-a11y" data-fm-apply>
            <?= $escaper->escapeHtml(__('Apply')) ?>
        </button>
    </form>
    <?php
};
?>
<div class="fm-bundle-overview-page fmbd-wrap pt-fmbd-5 pb-fmbd-8 max-md:pb-32" x-data="fmBundleOverview">
    <nav aria-label="<?= $escaper->escapeHtmlAttr(__('Breadcrumb')) ?>" class="text-fmbd-sm text-fmbd-text-muted">
        <ol class="flex flex-wrap items-center gap-fmbd-2">
            <li class="flex items-center gap-fmbd-2">
                <a href="<?= $escaper->escapeUrl($block->getBaseUrl()) ?>"
                   class="inline-flex items-center min-h-6 text-fmbd-text-muted underline-offset-2 hover:underline">
                    <?= $escaper->escapeHtml(__('Home')) ?>
                </a>
                <span aria-hidden="true">/</span>
            </li>
            <li><span aria-current="page"><?= $escaper->escapeHtml($overview->getHeading()) ?></span></li>
        </ol>
    </nav>

    <div class="flex flex-wrap items-end justify-between gap-x-fmbd-7 gap-y-fmbd-4 mt-fmbd-3 mb-fmbd-5">
        <div class="max-w-intro">
            <h1 class="fmbd-h-md text-fmbd-text"><?= $escaper->escapeHtml($overview->getHeading()) ?></h1>
            <?php if ($overview->getCmsBlockId() !== ''): ?>
                <div class="mt-fmbd-3 text-fmbd-text-soft">
                    <?= /* @noEscape */ $block->getLayout()->createBlock(CmsBlock::class)
