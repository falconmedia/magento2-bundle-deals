    <script type="application/ld+json"><?= /* @noEscape */ $overview->getJsonLd() ?></script>
</div>
<script>
    function initFmBundleOverview() {
        Alpine.data('fmBundleOverview', () => ({
            init() {
                this.$root.querySelectorAll('[data-fm-apply]').forEach((button) => {
                    button.classList.add('hidden');
                });
            },
            go() {
                const option = this.$el.selectedOptions[0];
                if (option && option.dataset.url) {
                    window.location.assign(option.dataset.url);
                }
            },
            openSheet() {
                this.$refs.sheet.showModal();
            },
            closeSheet() {
                this.$refs.sheet.close();
            },
            closeOnBackdrop(event) {
                if (event.target === this.$refs.sheet) {
                    this.closeSheet();
                }
            }
        }));

        Alpine.data('fmBundleCard', () => ({
            current: '',
            url: '',
            img0: '',
            img1: '',
            img2: '',
            setText: '',
            sumText: '',
            saveText: '',
            deliveryText: '',
            deliveryClass: '',
            colourText: '',
            init() {
                const pressed = this.$root.querySelector(`button[data-rule-id="${this.$root.dataset.ruleId}"]`);
                const images = this.$root.querySelectorAll('[data-fm-collage]');
                [this.img0, this.img1, this.img2] = [0, 1, 2].map((index) => images[index] ? images[index].src : '');
                if (pressed) {
                    this.apply(pressed);
                }
            },
            apply(button) {
                const state = JSON.parse(button.dataset.variant);
                this.current = button.dataset.ruleId;
                this.url = state.url;
                this.img0 = state.images[0] || this.img0;
                this.img1 = state.images[1] || this.img1;
                this.img2 = state.images[2] || this.img2;
                this.setText = state.set;
                this.sumText = state.sum;
                this.saveText = state.save;
                this.deliveryText = state.delivery;
                this.deliveryClass = state.direct ? 'text-fmbd-ok' : 'text-fmbd-warning';
                this.colourText = state.colour;
            },
            pick() {
                this.apply(this.$el);
            },
            isPressed() {
                return this.$el.dataset.ruleId === this.current ? 'true' : 'false';
            },
            hasDelivery() {
                return this.deliveryText !== '';
            }
        }));
    }

    window.addEventListener('alpine:init', initFmBundleOverview, {once: true});
</script>
<?php $hyvaCsp->registerInlineScript() ?>
