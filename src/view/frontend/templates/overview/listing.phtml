                                <?php if ($image !== ''): ?>
                                    <img src="<?= $escaper->escapeUrl($image) ?>" alt="" loading="lazy" decoding="async"
                                         width="<?= $index === 0 ? 320 : 160 ?>"
                                         height="<?= $index === 0 ? 320 : 160 ?>"
                                         class="w-full h-full object-contain scale-[1.18]" data-fm-collage
                                         <?= $hasSwitch ? ':src="img' . (int) $index . '"' : '' ?>>
                                <?php endif; ?>
                            </div>
                        <?php endforeach; ?>
                        <?php if ($percent > 0): ?>
                            <span class="fmbd-badge bg-fmbd-primary text-fmbd-on-primary">
                                <?= $escaper->escapeHtml(__('-%1%', $percent)) ?>
                            </span>
                        <?php endif; ?>
                        <span class="fmbd-badge fmbd-badge--dark top-auto bottom-fmbd-3 left-fmbd-3">
                            <?= $escaper->escapeHtml(__('Set of %1', (int) $card['itemCount'])) ?>
                        </span>
                    <?php if ($hasSwitch): ?>
                        <div class="fm-bundle-colours">
                            <div class="fm-bundle-colours__dots" role="group"
                                 aria-label="<?= $escaper->escapeHtmlAttr(__('Colour of the set')) ?>">
                                <?php foreach ($visibleVariants as $variant): ?>
                                    <?php
                                    $available = !empty($variant['inStock']);
                                    $variantState = $overview->getVariantState($variant);
                                    $swatchStyle = empty($variant['swatchHex'])
                                        ? ''
                                        : 'background-color: ' . $variant['swatchHex'];
                                    ?>
                                    <button type="button"
                                            class="fm-bundle-colours__dot group/dot inline-flex
                                                   items-center justify-center
                                                   rounded-full cursor-pointer
                                                   aria-disabled:cursor-not-allowed"
                                            data-rule-id="<?= (int) $variant['ruleId'] ?>"
                                            title="<?= $escaper->escapeHtmlAttr($variant['label']) ?>"
                                            data-variant="<?= $escaper->escapeHtmlAttr($variantState) ?>"
                                            aria-label="<?= $escaper->escapeHtmlAttr($available
                                                ? $variant['label']
                                                : __('%1, temporarily unavailable', $variant['label'])) ?>"
                                            <?php if ($available): ?>
                                                aria-pressed="<?= (int) $variant['ruleId'] === (int) $card['ruleId']
                                                    ? 'true' : 'false' ?>"
                                                :aria-pressed="isPressed"
                                                @click="pick"
                                            <?php else: ?>
                                                aria-disabled="true"
                                            <?php endif; ?>>
                                        <span class="relative block w-6 h-6 rounded-full border border-fmbd-border-strong
                                                     overflow-hidden bg-fmbd-surface-2 ring-fmbd-text ring-offset-2
                                                     ring-offset-fmbd-bg group-aria-pressed/dot:ring-2
                                                     group-aria-disabled/dot:opacity-60"
                                              <?php if ($swatchStyle !== ''): ?>
                                                  style="<?= $escaper->escapeHtmlAttr($swatchStyle) ?>"
                                              <?php endif; ?>>
                                            <?php if (empty($variant['swatchHex']) && !empty($variant['imageUrl'])): ?>
                                                <img src="<?= $escaper->escapeUrl($variant['imageUrl']) ?>" alt=""
                                                     width="24" height="24" loading="lazy"
                                                     class="w-full h-full object-cover">
                                            <?php endif; ?>
                                            <?php if (!$available): ?>
                                                <span class="absolute left-1/2 top-0 h-full w-0.5 -translate-x-1/2
                                                             rotate-45 bg-fmbd-text"></span>
                                            <?php endif; ?>
                                        </span>
                                    </button>
                                <?php endforeach; ?>
                            </div>
                            <?php if (count($variants) > 4): ?>
                                <span class="fm-bundle-colours__more fmbd-num">
                                    <span aria-hidden="true">+<?= count($variants) - 4 ?></span>
                                    <span class="sr-only">
                                        <?= $escaper->escapeHtml(__('%1 more colours', count($variants) - 4)) ?>
                                    </span>
                                </span>
                            <?php endif; ?>
                            <span class="sr-only" x-text="colourText">
                                <?= $escaper->escapeHtml(__('Colour: %1', $currentLabel)) ?>
