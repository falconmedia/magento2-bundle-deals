                <?= $escaper->escapeHtml($texts->get('overview_empty_title')) ?>
            </h2>
            <p class="m-0 text-fmbd-text-muted"><?= $escaper->escapeHtml($texts->get('overview_empty_hint')) ?></p>
            <?php if ($filters): ?>
                <a href="<?= $escaper->escapeUrl($overview->getResetUrl()) ?>"
