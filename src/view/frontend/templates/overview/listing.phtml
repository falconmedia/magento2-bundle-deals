                                rounded-fmbd-md bg-fmbd-surface-2 p-fmbd-1 overflow-hidden">
                        <?php foreach ($images as $index => $image): ?>
                            <div class="<?= $index === 0 ? 'row-span-2' : '' ?> flex items-center justify-center
