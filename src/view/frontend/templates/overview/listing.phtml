        <ul class="grid grid-cols-2 lg:grid-cols-4 gap-x-fmbd-4 gap-y-fmbd-6 md:gap-x-fmbd-5">
            <?php foreach ($cards as $card): ?>
                <?php
                $variants = $card['variants'];
                $hasSwitch = count($variants) > 1;
                $images = array_values(array_pad(array_slice($card['images'], 0, 3), 3, ''));
                $percent = (int) round((float) $card['maxDiscountPercent']);
                $currentLabel = '';
                $currentVariant = null;
                foreach ($variants as $variant) {
                    if ((int) $variant['ruleId'] === (int) $card['ruleId']) {
                        $currentLabel = (string) $variant['label'];
                        $currentVariant = $variant;
                    }
                }
                // The card's own variant always gets a dot, also when it sorts behind the visible ones.
                $visibleVariants = array_slice($variants, 0, 4);
                if ($currentVariant !== null && !in_array($currentVariant, $visibleVariants, true)) {
                    $visibleVariants[count($visibleVariants) - 1] = $currentVariant;
                }
                ?>
                <li class="relative flex flex-col gap-fmbd-2 group/card" data-rule-id="<?= (int) $card['ruleId'] ?>"
                    <?= $hasSwitch ? 'x-data="fmBundleCard"' : '' ?>>
                    <div class="fm-bundle-collage <?= $hasSwitch ? 'fm-bundle-collage--colours' : '' ?>
