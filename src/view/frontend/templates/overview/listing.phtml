                                 group-hover/card:bg-fmbd-text group-hover/card:text-fmbd-bg" aria-hidden="true">
                        <?= $escaper->escapeHtml(__('View set')) ?>
                    </span>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>

    <?php if ($pager['pages'] > 1): ?>
        <nav class="mt-fmbd-7" aria-label="<?= $escaper->escapeHtmlAttr(__('Pagination')) ?>">
            <ol class="flex flex-wrap items-center justify-center gap-fmbd-2">
