<script>
    function <?= /* @noEscape */ $uid ?>() {
        const config = <?= /* @noEscape */ json_encode($config, $jsonFlags) ?>;
        const text = (template, ...values) => values.reduce(
            (result, value, index) => result.replace('%' + (index + 1), value), template
        );
        const money = (value) => hyva.formatPrice(value);
        const blankPicks = (variant, previous) => variant.items.map((item, index) => {
            const old = previous && previous[index] ? previous[index] : null;
            const pick = {cand: 0, chosen: {}, included: old ? old.included : true};
            if (old && old.cand < item.candidates.length) {
                pick.cand = old.cand;
            }
            const options = item.candidates[pick.cand].options;
            (options ? options.attributes : []).forEach((attribute) => {
                const kept = old ? old.chosen[attribute.code] : '';
                if (kept && attribute.options.some((option) => option.label === kept)) {
                    pick.chosen[attribute.code] = kept;
                } else if (attribute.options.length === 1) {
                    pick.chosen[attribute.code] = attribute.options[0].label;
                }
            });
            return pick;
        });

        return {
            ruleId: config.ruleId,
            variants: config.variants,
            picks: [],
            photo: 0,
            qty: 1,
            loading: false,
            error: '',
            attempted: false,
            added: false,
            stickyVisible: false,

            init() {
                this.picks = blankPicks(this.variant, null);
                const button = this.$el.querySelector('[data-fm-set-buy]');
                if (button && 'IntersectionObserver' in window) {
                    new IntersectionObserver((entries) => {
                        this.stickyVisible = !entries[0].isIntersecting && entries[0].boundingClientRect.top < 0;
                    }).observe(button);
                }
            },

            text(template, ...values) {
                return text(template, ...values);
            },

            get variant() {
                return this.variants.find((variant) => variant.ruleId === this.ruleId);
            },

            get views() {
                return this.variant.items.map((item, index) => this.view(item, index));
            },

            view(item, index) {
                const pick = this.picks[index] || {cand: 0, chosen: {}, included: true};
                const product = item.candidates[pick.cand];
                const attributes = (product.options ? product.options.attributes : []).map((attribute) => ({
                    id: attribute.id,
                    code: attribute.code,
                    label: attribute.label,
                    options: attribute.options.map((option) => ({
                        id: option.id,
                        label: option.label,
                        selected: pick.chosen[attribute.code] === option.label,
                        available: this.isOptionAvailable(product, pick, attribute, option)
                    }))
                }));
                const childId = this.childId(product, pick);
                let prices = childId && product.options.prices[childId]
                    ? product.options.prices[childId]
                    : {finalPrice: product.finalPrice, regularPrice: product.regularPrice};
                if (!childId && !(prices.finalPrice > 0)) {
                    const childPrices = Object.values(product.options.prices || {}).filter((entry) => entry.finalPrice > 0);
                    if (childPrices.length) {
                        prices = childPrices.reduce((lowest, entry) => (entry.finalPrice < lowest.finalPrice ? entry : lowest));
                    }
                }
                const regular = Math.max(prices.finalPrice, prices.regularPrice);
                const included = item.type !== 'optional' || pick.included;
                const sizeLabel = Object.values(pick.chosen).join(' / ');
                const complete = attributes.every((attribute) => attribute.options.some((option) => option.selected));
                let discounted = prices.finalPrice;
                if (item.discount.type === 'percent') {
                    discounted = prices.finalPrice * (1 - Math.min(Number(item.discount.amount), 100) / 100);
                } else if (item.discount.type === 'fixed') {
                    discounted = Math.max(0, prices.finalPrice - Number(item.discount.amount));
                }
                const delivery = this.variant.delivery[childId || product.productId] || null;
                return {
                    index: index,
                    slotId: item.slotId,
                    type: item.type,
                    optional: item.type === 'optional',
                    included: included,
                    product: product,
                    candidates: item.candidates,
                    pick: pick,
                    attributes: attributes,
                    sizeLabel: sizeLabel,
                    complete: complete,
                    childId: childId,
                    regular: regular,
                    discounted: discounted,
                    delivery: delivery
                };
            },

            childId(product, pick) {
                if (!product.options) {
                    return null;
                }
                let candidates = null;
                for (const attribute of product.options.attributes) {
                    const option = attribute.options.find((entry) => entry.label === pick.chosen[attribute.code]);
                    if (!option) {
                        return null;
                    }
                    candidates = candidates === null
                        ? option.products
                        : candidates.filter((id) => option.products.includes(id));
                }
                return candidates && candidates.length ? candidates[0] : null;
            },

            isOptionAvailable(product, pick, attribute, option) {
                return product.options.attributes.filter((other) => other.code !== attribute.code).every((other) => {
                    const chosen = other.options.find((entry) => entry.label === pick.chosen[other.code]);
                    return !chosen || chosen.products.some((id) => option.products.includes(id));
                });
            },

            choose(index, attribute, option) {
                if (!option.available) {
                    return;
                }
                const pick = this.picks[index];
                pick.chosen = Object.assign({}, pick.chosen, {[attribute.code]: option.label});
            },

            pickCandidate(index, candidate) {
                this.picks[index] = {cand: candidate, chosen: {}, included: this.picks[index].included};
                this.picks[index] = blankPicks({items: [this.variant.items[index]]}, [this.picks[index]])[0];
            },

            toggleIncluded(index) {
                this.picks[index].included = !this.picks[index].included;
            },

            switchVariant(ruleId) {
                const next = this.variants.find((variant) => variant.ruleId === ruleId);
                if (!next || !next.available || ruleId === this.ruleId) {
                    return;
                }
                const previous = this.picks.map((pick, index) => Object.assign({}, pick, {
                    chosen: Object.assign({}, pick.chosen)
                }));
                this.ruleId = ruleId;
                this.picks = blankPicks(next, previous);
                this.photo = 0;
                this.error = '';
                window.history.replaceState({}, '', next.url);
            },

            get includedViews() {
                return this.views.filter((view) => view.included);
            },

            get sumPrice() {
                return this.includedViews.reduce((total, view) => total + view.regular, 0);
            },

            get setPrice() {
                return this.includedViews.reduce((total, view) => total + view.discounted, 0);
            },

            get saving() {
                return Math.max(0, this.sumPrice - this.setPrice);
            },

            get percent() {
                return this.sumPrice > 0 ? Math.round(this.saving / this.sumPrice * 100) : 0;
            },

            get missing() {
                return this.includedViews.filter((view) => !view.complete).length;
            },

            get buttonLabel() {
                if (this.missing === 1) {
                    return config.i18n.chooseSizesOne;
                }
                if (this.missing > 1) {
                    return text(config.i18n.chooseSizes, this.missing);
                }
                return text(config.i18n.addSet, money(this.setPrice * this.qty));
            },

            get delivery() {
                if (this.missing > 0) {
                    return {tone: 'neutral', label: config.i18n.chooseSizesFirst};
                }
                const deliveries = this.includedViews.map((view) => view.delivery);
                if (deliveries.every((delivery) => delivery && delivery.direct)) {
                    return {tone: 'ok', label: config.i18n.allTomorrow};
                }
                const known = deliveries.filter((delivery) => delivery && delivery.maxDays !== null);
                if (known.length) {
                    const min = Math.max(...known.map((delivery) => delivery.minDays || delivery.maxDays));
                    const max = Math.max(...known.map((delivery) => delivery.maxDays));
                    return {
                        tone: 'warning',
                        label: min === max
                            ? text(config.i18n.completeDays, max)
                            : text(config.i18n.completeRange, min, max)
                    };
                }
                return {tone: 'warning', label: config.i18n.completeLater};
            },

            get photos() {
                return this.variant.images;
            },

            get tileColumns() {
                const columns = {
                    1: 'lg:grid-cols-1', 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4',
                    5: 'lg:grid-cols-5', 6: 'lg:grid-cols-3', 7: 'lg:grid-cols-4', 8: 'lg:grid-cols-4',
                    9: 'lg:grid-cols-5', 10: 'lg:grid-cols-5'
                };
                return columns[Math.min(this.views.length, 10)] || 'lg:grid-cols-5';
            },

            get tilePhotos() {
                return this.views.map((view) => ({
                    image: view.product.imageLarge || view.product.image,
                    name: view.product.name,
                    included: view.included
                }));
            },

            money(value) {
                return money(value);
            },

            async submit() {
                if (this.missing > 0) {
                    this.attempted = true;
                }
                if (this.missing > 0 || this.loading || !this.includedViews.length) {
                    return;
                }
                this.loading = true;
                this.error = '';
                this.added = false;
                const body = new FormData();
                body.append('form_key', hyva.getFormKey());
                body.append('rule_id', this.ruleId);
                body.append('complete', '1');
                body.append('qty', this.qty);
                this.includedViews.forEach((view, position) => {
                    body.append('items[' + position + '][slot_id]', view.slotId);
                    body.append('items[' + position + '][product_id]', view.product.productId);
                    view.attributes.forEach((attribute) => {
                        const option = attribute.options.find((entry) => entry.selected);
                        body.append(
                            'items[' + position + '][super_attribute][' + attribute.id + ']',
                            option.id
                        );
                    });
                });
                try {
                    const response = await fetch(config.addUrl, {
                        method: 'POST',
                        body: body,
                        headers: {'X-Requested-With': 'XMLHttpRequest'}
                    });
                    const result = await response.json();
                    if (result.success) {
                        this.added = true;
                        window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                        this.notify('success', result.message || config.i18n.added);
                    } else {
                        this.error = result.message || config.i18n.error;
                        this.notify('error', this.error);
                    }
                } catch (e) {
                    this.error = config.i18n.error;
                    this.notify('error', this.error);
                } finally {
                    this.loading = false;
                }
            },

            notify(type, message) {
                if (typeof window.dispatchMessages !== 'undefined' && message) {
                    window.dispatchMessages([{type: type, text: message}], 5000);
                }
            }
        };
    }
</script>
