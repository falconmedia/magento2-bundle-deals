/**
 * Renders the colour dots; real links so the colours also work without JavaScript.
 */
$renderDots = static function (string $idPrefix) use ($variants, $ruleId, $escaper): string {
    $html = '';
    foreach ($variants as $variant) {
        $id = (int) $variant['ruleId'];
        $label = (string) __('Colour %1', $variant['label']);
        $image = (string) ($variant['imageUrl'] ?? '');
        $style = ($image === '' && !empty($variant['swatchHex'])) ? ' style="background-color: '
            . $escaper->escapeHtmlAttr($variant['swatchHex']) . '"' : '';
        $img = $image === '' ? '' : '<img src="' . $escaper->escapeUrl($image) . '" alt="" width="56" height="56"'
            . ' loading="lazy" class="block h-full w-full object-contain">';
        $slash = $variant['available']
            ? ''
            : '<span class="absolute left-1/2 top-0 h-full w-0.5 -translate-x-1/2 rotate-45 bg-fmbd-text"></span>';
        $attributes = $variant['available']
            ? ' href="' . $escaper->escapeUrl($variant['url']) . '" @click.prevent="switchVariant(' . $id . ')"'
            : ' aria-disabled="true"';
        $html .= '<a' . $attributes . ' id="' . $idPrefix . $id . '"'
            . ' aria-label="' . $escaper->escapeHtmlAttr($label) . '"'
            . ' :aria-pressed="ruleId === ' . $id . ' ? \'true\' : \'false\'"'
            . ' class="group/dot inline-flex shrink-0 items-center justify-center p-fmbd-1 rounded-fmbd-md'
            . ' focus-visible:outline focus-visible:outline-2 focus-visible:outline-fmbd-focus'
            . ($variant['available'] ? ' cursor-pointer' : ' cursor-not-allowed') . '">'
            . '<span class="relative block w-14 h-14 rounded-fmbd-md border overflow-hidden bg-fmbd-surface-3 p-fmbd-1"'
            . ' :class="ruleId === ' . $id . ' ? \'border-2 border-fmbd-text\' : \'border-fmbd-border\'"'
            . $style . '>' . $img . $slash . '</span></a>';
    }

    return $html;
};

